// Twingate Tray: połącz/rozłącz (start/stop/restart twingate.service) bez hasła dla użytkowników
// z grupy wheel w aktywnej, lokalnej sesji - odpowiednik operatora Tailscale dla tailscale-tray.
// Włączanie autostartu (enable/disable) nadal pyta o hasło.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "twingate.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
